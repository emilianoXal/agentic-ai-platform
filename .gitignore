# Terraform working dirs and state
.terraform/
*.tfstate
*.tfstate.*

# Saved plans
tfplan

# Lambda/compute build artifacts (generated by archive_file at plan time)
modules/compute/build/*
!modules/compute/build/.gitkeep
modules/compute/layers/pillow/python/
modules/agent/build/*
!modules/agent/build/.gitkeep
modules/portal/build/*
!modules/portal/build/.gitkeep
modules/follow_up/build/*
!modules/follow_up/build/.gitkeep

# Workflow/agent task artifacts (internal planning docs, not part of the repo)
.agents/

# Python bytecode from local unittest runs
__pycache__/
*.pyc

# Terraform crash logs
crash.log

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — the provider lock
# file is committed to pin provider versions across runners.
